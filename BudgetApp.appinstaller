    xmlns="http://schemas.microsoft.com/appx/appinstaller/2018"
    Version="1.0.0.0"
    Uri="http://192.168.2.63:8080/BudgetApp.appinstaller">
    
    <MainPackage
        Name="Budget.Mobile"
        Publisher="CN=BudgetDev"
        Version="1.0.0.0"
